<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ObsidianLauncher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ObsidianLauncher.Views.InstancesView"
             x:DataType="vm:InstancesViewModel">

    <UserControl.Resources>
        <!-- Converter for bool to opacity -->
        <x:Double x:Key="EnabledOpacity">1.0</x:Double>
        <x:Double x:Key="DisabledOpacity">0.6</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Style for disabled instances -->
        <Style Selector="Border.disabled">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <!-- InstancesViewModel requires InstanceManager parameter, so no design data context -->
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8" Spacing="8">
            <Button Content="Create Instance" 
                    Command="{Binding CreateInstanceCommand}"
                    Padding="12,6" 
                    Classes="accent"/>
            <Button Content="Import Instance" Padding="12,6"/>
            <Separator/>
            <Button Content="Refresh" 
                    Command="{Binding RefreshCommand}"
                    Padding="12,6"/>
        </StackPanel>

        <!-- Instance Grid -->
        <ScrollViewer Grid.Row="1" Margin="8">
            <ItemsControl ItemsSource="{Binding Instances}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="200" ItemHeight="240"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" 
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="8" 
                                Margin="4"
                                Classes.disabled="{Binding !IsEnabled}"
                                Name="InstanceBorder">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Instance Icon -->
                                <Border Grid.Row="0" 
                                        Background="{DynamicResource SystemControlBackgroundAltMediumBrush}" 
                                        CornerRadius="4">
                                    <Image Width="64" Height="64" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                </Border>

                                <!-- Progress Indicator (overlay on icon when setting up) -->
                                <ProgressBar Grid.Row="0"
                                            Value="{Binding SetupProgress}"
                                            Maximum="100"
                                            Width="80"
                                            Height="8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,8"
                                            IsVisible="{Binding IsSettingUp}"/>

                                <!-- Instance Name -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding Name}" 
                                           FontWeight="Bold" 
                                           TextAlignment="Center" 
                                           Margin="0,8,0,4" 
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Instance Version -->
                                <TextBlock Grid.Row="2" 
                                           Text="{Binding MinecraftVersion}" 
                                           FontSize="12" 
                                           Opacity="0.7" 
                                           TextAlignment="Center" 
                                           Margin="0,0,0,4"/>

                                <!-- Setup Status (when setting up) -->
                                <TextBlock Grid.Row="3" 
                                           Text="{Binding SetupStatus}" 
                                           FontSize="10" 
                                           Opacity="0.8" 
                                           TextAlignment="Center" 
                                           Margin="0,0,0,4"
                                           IsVisible="{Binding IsSettingUp}"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Last Played (when ready) -->
                                <TextBlock Grid.Row="3" 
                                           Text="{Binding LastPlayedFormatted}" 
                                           FontSize="10" 
                                           Opacity="0.6" 
                                           TextAlignment="Center" 
                                           Margin="0,0,0,4"
                                           IsVisible="{Binding IsEnabled}"/>

                                <!-- Progress Text (when setting up) -->
                                <TextBlock Grid.Row="4" 
                                           Text="{Binding SetupProgress, StringFormat='{}{0:F0}%'}" 
                                           FontSize="9" 
                                           Opacity="0.6" 
                                           TextAlignment="Center" 
                                           Margin="0,0,0,8"
                                           IsVisible="{Binding IsSettingUp}"/>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="5" 
                                            Orientation="Horizontal" 
                                            HorizontalAlignment="Center" 
                                            Spacing="4">
                                    <Button Content="Launch" 
                                            Padding="8,4" 
                                            FontSize="11"
                                            IsEnabled="{Binding IsEnabled}"
                                            Command="{Binding $parent[ItemsControl].DataContext.LaunchInstanceCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Edit" 
                                            Padding="8,4" 
                                            FontSize="11"
                                            Command="{Binding $parent[ItemsControl].DataContext.EditInstanceCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !Instances.Count}">
            <TextBlock Text="No instances found" 
                       FontSize="18" 
                       Opacity="0.6" 
                       TextAlignment="Center" 
                       Margin="0,0,0,16"/>
            <Button Content="Create Your First Instance" 
                    Command="{Binding CreateInstanceCommand}"
                    Padding="16,8" 
                    Classes="accent"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>