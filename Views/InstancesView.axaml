<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ObsidianLauncher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ObsidianLauncher.Views.InstancesView"
             x:DataType="vm:InstancesViewModel">

    <Design.DataContext>
        <vm:InstancesViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8" Spacing="8">
            <Button Content="Create Instance" Padding="12,6"/>
            <Button Content="Import Instance" Padding="12,6"/>
            <Separator/>
            <Button Content="Refresh" Padding="12,6"/>
        </StackPanel>

        <!-- Instance Grid -->
        <ScrollViewer Grid.Row="1" Margin="8">
            <ItemsControl ItemsSource="{Binding Instances}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="200" ItemHeight="240"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" 
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="8" 
                                Margin="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Instance Icon -->
                                <Border Grid.Row="0" 
                                        Background="{DynamicResource SystemControlBackgroundAltMediumBrush}" 
                                        CornerRadius="4">
                                    <Image Width="64" Height="64" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                </Border>

                                <!-- Instance Name -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding Name}" 
                                           FontWeight="Bold" 
                                           TextAlignment="Center" 
                                           Margin="0,8,0,4" 
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Instance Version -->
                                <TextBlock Grid.Row="2" 
                                           Text="{Binding MinecraftVersion}" 
                                           FontSize="12" 
                                           Opacity="0.7" 
                                           TextAlignment="Center" 
                                           Margin="0,0,0,4"/>

                                <!-- Last Played -->
                                <TextBlock Grid.Row="3" 
                                           Text="{Binding LastPlayedFormatted}" 
                                           FontSize="10" 
                                           Opacity="0.6" 
                                           TextAlignment="Center" 
                                           Margin="0,0,0,8"/>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="4" 
                                            Orientation="Horizontal" 
                                            HorizontalAlignment="Center" 
                                            Spacing="4">
                                    <Button Content="Launch" 
                                            Padding="8,4" 
                                            FontSize="11"
                                            Command="{Binding $parent[ItemsControl].DataContext.LaunchInstanceCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Edit" 
                                            Padding="8,4" 
                                            FontSize="11"
                                            Command="{Binding $parent[ItemsControl].DataContext.EditInstanceCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !Instances.Count}">
            <TextBlock Text="No instances found" 
                       FontSize="18" 
                       Opacity="0.6" 
                       TextAlignment="Center" 
                       Margin="0,0,0,16"/>
            <Button Content="Create Your First Instance" 
                    Padding="16,8" 
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>