<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsidianLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="776"
             x:Class="ObsidianLauncher.Views.ModBrowserView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="64,*">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource BaseBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Mod browser"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg1Brush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="· powered by Modrinth"
                           FontSize="13"
                           Foreground="{DynamicResource Fg3Brush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Per-instance guidance -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
            <TextBlock FontFamily="{StaticResource FontAwesomeSolidFont}" FontWeight="Black"
                       Text="&#xF1B2;"
                       FontSize="56"
                       Foreground="{DynamicResource PrimaryBrush}"
                       HorizontalAlignment="Center"
                       Opacity="0.4"/>
            <TextBlock Text="Mod browser is per-instance"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg1Brush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Right-click an instance card and choose Browse Mods to search and install mods from Modrinth."
                       FontSize="14"
                       Foreground="{DynamicResource Fg3Brush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="380"/>
        </StackPanel>

    </Grid>

</UserControl>
