<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsidianLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="776"
             x:Class="ObsidianLauncher.Views.ModBrowserView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="64,*">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource BaseBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Mod browser"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg1Brush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="· powered by Modrinth"
                               FontSize="13"
                               Foreground="{DynamicResource Fg3Brush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource Surface0Brush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,0"
                        Width="260"
                        Height="38">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.5"/>
                        <TextBox Grid.Column="1"
                                 Watermark="Search Modrinth…"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13.5"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Coming soon placeholder -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
            <TextBlock Text="⬡"
                       FontSize="64"
                       Foreground="{DynamicResource PrimaryBrush}"
                       HorizontalAlignment="Center"
                       Opacity="0.4"/>
            <TextBlock Text="Mod browser coming soon"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg1Brush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Powered by Modrinth. Browse, install, and update mods right here."
                       FontSize="14"
                       Foreground="{DynamicResource Fg3Brush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="360"/>
        </StackPanel>

    </Grid>

</UserControl>
