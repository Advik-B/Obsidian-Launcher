<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ObsidianLauncher.ViewModels"
        x:Class="ObsidianLauncher.Views.AccountManagementWindow"
        x:CompileBindings="False"
        Title="Manage Accounts"
        Width="600" Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Design.DataContext>
        <vm:AccountManagementViewModel/>
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Accounts" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Account List -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Account List" FontWeight="SemiBold" Margin="0,0,0,5"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Accounts}"
                             SelectedItem="{Binding SelectedAccount}"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="{Binding Username}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TypeDisplay}" VerticalAlignment="Center" Foreground="Gray" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Spacing="10">
                <Button Content="Add Offline Account"
                        Command="{Binding AddOfflineAccountCommand}"
                        Width="150"/>

                <Button Content="Add Microsoft Account"
                        Command="{Binding AddMicrosoftAccountCommand}"
                        Width="150"/>

                <Separator Margin="0,5"/>

                <Button Content="Set as Active"
                        Command="{Binding SetActiveAccountCommand}"
                        Width="150"/>

                <Button Content="Remove"
                        Command="{Binding RemoveAccountCommand}"
                        Width="150"/>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Close" Command="{Binding CloseCommand}" Width="100" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
