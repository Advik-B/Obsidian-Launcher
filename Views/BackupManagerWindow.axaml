<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="460"
        x:Class="ObsidianLauncher.Views.BackupManagerWindow"
        x:CompileBindings="False"
        Title="Backup Manager"
        Width="680" Height="460"
        MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- Bottom action bar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Opacity="0.7" Margin="0,0,12,0"/>
            <Button x:Name="CreateBackupBtn" Content="Create Backup" Padding="14,6"/>
            <Button x:Name="RestoreBtn" Content="Restore" Padding="14,6" IsEnabled="False"/>
            <Button x:Name="DeleteBtn" Content="Delete" Padding="14,6" IsEnabled="False"/>
            <Button Content="Close" IsCancel="True" Padding="14,6" Click="CloseBtn_Click"/>
        </StackPanel>

        <!-- Master-detail split -->
        <Grid ColumnDefinitions="200,1,*">

            <!-- Instance list (left) -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="INSTANCES" FontSize="10" FontWeight="Bold"
                           Opacity="0.5" LetterSpacing="0.12" Margin="4,0,0,6"/>
                <ListBox x:Name="InstanceListBox" SelectionChanged="InstanceListBox_SelectionChanged"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="4,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Separator -->
            <Border Grid.Column="1" Background="{DynamicResource BorderSoftBrush}" Width="1" Margin="6,0"/>

            <!-- Backup list (right) -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="BACKUPS" FontSize="10" FontWeight="Bold"
                           Opacity="0.5" LetterSpacing="0.12" Margin="4,0,0,6"/>
                <TextBlock x:Name="NoBackupsText" DockPanel.Dock="Top"
                           Text="No backups for this instance."
                           IsVisible="False" Opacity="0.5" Margin="4,20,0,0"/>
                <ListBox x:Name="BackupListBox" SelectionChanged="BackupListBox_SelectionChanged"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,3">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding DateDisplay}" Opacity="0.6" FontSize="11" Margin="12,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Opacity="0.6" FontSize="11" Width="60" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

        </Grid>

    </DockPanel>

</Window>
