<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ObsidianLauncher.ViewModels"
        xmlns:views="using:ObsidianLauncher.Views"
        xmlns:controls="using:ObsidianLauncher.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="ObsidianLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://Obsidian Launcher/Images/icon.ico"
        Title="Obsidian Launcher"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="{DynamicResource CrustBrush}"
        FontFamily="{StaticResource QuicksandFont}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Root: window chrome border -->
    <Border CornerRadius="24"
            Background="{DynamicResource BaseBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            ClipToBounds="True">

        <Grid RowDefinitions="44,*">

            <!-- ============================================================
                 TITLE BAR
                 ============================================================ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MantleBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,0,0,1"
                    x:Name="TitleBar"
                    PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Left: traffic dots + branding -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="14"
                                Margin="14,0"
                                VerticalAlignment="Center">
                        <!-- Traffic dots -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="12" Height="12" CornerRadius="6"
                                    Background="#ed6a5e"
                                    ToolTip.Tip="Close"
                                    Cursor="Hand"
                                    x:Name="CloseBtn">
                            </Border>
                            <Border Width="12" Height="12" CornerRadius="6"
                                    Background="#f5bf4f"
                                    ToolTip.Tip="Minimize"
                                    Cursor="Hand"
                                    x:Name="MinimizeBtn">
                            </Border>
                            <Border Width="12" Height="12" CornerRadius="6"
                                    Background="#62c554"
                                    ToolTip.Tip="Maximize"
                                    Cursor="Hand"
                                    x:Name="MaximizeBtn">
                            </Border>
                        </StackPanel>

                        <!-- Title -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Obsidian Launcher"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg2Brush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="· cozy edition"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: status indicators -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="14,0"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="Ready"
                                       FontSize="11"
                                       Foreground="{DynamicResource Fg3Brush}"/>
                        </StackPanel>
                        <TextBlock Text="·"
                                   FontSize="11"
                                   Foreground="{DynamicResource Border1Brush}"/>
                        <TextBlock Text="v0.1.0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Fg3Brush}"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ============================================================
                 BODY: Sidebar + Content
                 ============================================================ -->
            <Grid Grid.Row="1" ColumnDefinitions="240,*">

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="{DynamicResource MantleBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="0,0,1,0">
                    <DockPanel>

                        <!-- Brand + Nav -->
                        <StackPanel DockPanel.Dock="Top" Margin="14,18,14,0" Spacing="0">

                            <!-- Brand -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,6,18">
                                <controls:PixelCatControl CatSize="32"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Obsidian"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Fg1Brush}"
                                               LetterSpacing="-0.01"/>
                                    <TextBlock Text="a sleepy launcher"
                                               FontFamily="{StaticResource PlaywriteFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Account chip -->
                            <Border Background="{DynamicResource Surface0Brush}"
                                    CornerRadius="14"
                                    Padding="10,8"
                                    Margin="0,0,0,14"
                                    Cursor="Hand"
                                    x:Name="AccountChip"
                                    PointerPressed="AccountChip_PointerPressed">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="8"
                                            Background="{DynamicResource SecondaryBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="P"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="Player"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Fg1Brush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Width="6" Height="6" CornerRadius="3"
                                                    Background="{DynamicResource SuccessBrush}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="online"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Fg3Brush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="⌄"
                                               FontSize="14"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Library section -->
                            <TextBlock Text="LIBRARY"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       LetterSpacing="0.14"
                                       Margin="10,14,10,6"/>

                            <Button Classes="nav-item"
                                    Classes.active="{Binding IsInstancesScreen}"
                                    Command="{Binding NavigateToInstancesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="▶" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Instances" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="nav-item"
                                    Classes.active="{Binding IsModsScreen}"
                                    Command="{Binding NavigateToModsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="⬡" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mod browser" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="nav-item"
                                    Classes.active="{Binding IsWorldsScreen}"
                                    Command="{Binding NavigateToWorldsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="◉" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Worlds" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="nav-item"
                                    Classes.active="{Binding IsScreenshotsScreen}"
                                    Command="{Binding NavigateToScreenshotsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="⬛" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Screenshots" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- System section -->
                            <TextBlock Text="SYSTEM"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       LetterSpacing="0.14"
                                       Margin="10,14,10,6"/>

                            <Button Classes="nav-item"
                                    Classes.active="{Binding IsConsoleScreen}"
                                    Command="{Binding NavigateToConsoleCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text=">" FontSize="14" VerticalAlignment="Center" FontFamily="Monospace"/>
                                    <TextBlock Text="Console" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="nav-item"
                                    Classes.active="{Binding IsAccountsScreen}"
                                    Command="{Binding NavigateToAccountsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="👤" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Accounts" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="nav-item"
                                    Classes.active="{Binding IsSettingsScreen}"
                                    Command="{Binding NavigateToSettingsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!-- Sleeping cat card at bottom -->
                        <Border DockPanel.Dock="Bottom"
                                Margin="14,0,14,14"
                                Background="{DynamicResource Surface0Brush}"
                                CornerRadius="18"
                                Padding="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="44" Height="44" CornerRadius="22"
                                        Background="{DynamicResource PrimaryTintBrush}">
                                    <controls:PixelCatControl CatSize="28"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Quiet hours"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBlock Text="Notifications muted"
                                               FontSize="11"
                                               Foreground="{DynamicResource Fg2Brush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </DockPanel>
                </Border>

                <!-- CONTENT AREA -->
                <Grid Grid.Column="1" RowDefinitions="*,30">

                    <!-- Screen content (no dedicated header - each view has its own) -->
                    <Panel Grid.Row="0">

                        <!-- Instances screen -->
                        <views:InstancesView IsVisible="{Binding IsInstancesScreen}"/>

                        <!-- Mod browser screen -->
                        <views:ModBrowserView IsVisible="{Binding IsModsScreen}"/>

                        <!-- Worlds screen -->
                        <views:WorldsView IsVisible="{Binding IsWorldsScreen}"/>

                        <!-- Screenshots screen -->
                        <views:ScreenshotsView IsVisible="{Binding IsScreenshotsScreen}"/>

                        <!-- Console screen -->
                        <views:ConsoleView IsVisible="{Binding IsConsoleScreen}"/>

                        <!-- Accounts screen -->
                        <views:AccountsView IsVisible="{Binding IsAccountsScreen}"/>

                        <!-- Settings screen -->
                        <views:SettingsView IsVisible="{Binding IsSettingsScreen}"/>

                        <!-- Overlays (on top of everything) -->
                        <views:CreateInstanceOverlay IsVisible="{Binding IsCreateInstanceOpen}"/>
                        <views:InstanceSettingsOverlay IsVisible="{Binding IsInstanceSettingsOpen}"/>

                    </Panel>

                    <!-- STATUS BAR -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource MantleBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="18,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="18"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="6" Height="6" CornerRadius="3"
                                            Background="{DynamicResource SuccessBrush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="Java 21 LTS"
                                               FontSize="11"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                </StackPanel>
                                <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource Border1Brush}"/>
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Fg3Brush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       FontSize="11"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       VerticalAlignment="Center"
                                       Text="Mojang OK"/>
                        </Grid>
                    </Border>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</Window>
