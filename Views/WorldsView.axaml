<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsidianLauncher.ViewModels"
             xmlns:controls="using:ObsidianLauncher.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="776"
             x:Class="ObsidianLauncher.Views.WorldsView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="64,*">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource BaseBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Worlds"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Fg1Brush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="· across all instances"
                               FontSize="13"
                               Foreground="{DynamicResource Fg3Brush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="secondary" Padding="14,8">
                        <TextBlock Text="Import .zip"/>
                    </Button>
                    <Button Classes="primary" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="+" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="New world" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Placeholder body -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
            <controls:PixelCatControl CatSize="72"
                                      HorizontalAlignment="Center"/>
            <TextBlock Text="World browser coming soon"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg1Brush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Browse and manage your Minecraft worlds here."
                       FontSize="14"
                       Foreground="{DynamicResource Fg3Brush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="320"/>
        </StackPanel>

    </Grid>

</UserControl>
