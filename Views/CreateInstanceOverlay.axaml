<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsidianLauncher.ViewModels"
             xmlns:utils="using:ObsidianLauncher.Utils"
             xmlns:controls="using:ObsidianLauncher.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="776"
             x:Class="ObsidianLauncher.Views.CreateInstanceOverlay"
             x:DataType="vm:MainWindowViewModel">

    <!-- Dark scrim -->
    <Border Background="#66111111"
            x:Name="Scrim"
            PointerPressed="Scrim_PointerPressed">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Modal card -->
            <Border Background="{DynamicResource BaseBrush}"
                    CornerRadius="24"
                    Width="680"
                    MaxHeight="700"
                    BoxShadow="0 18 40 #4D000000">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="22,18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CreateStepLabel}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           LetterSpacing="0.14"/>
                                <TextBlock Text="{Binding CreateStepTitle}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Fg1Brush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Padding="8"
                                    CornerRadius="12"
                                    Command="{Binding CloseCreateInstanceCommand}">
                                <TextBlock Text="✕" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body: three steps, only one visible at a time -->
                    <ScrollViewer Grid.Row="1" Padding="22"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Panel>

                            <!-- Step 1: Name + Palette -->
                            <StackPanel Spacing="18" IsVisible="{Binding IsCreateStep1}">

                                <!-- Name input -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="What should we call it?"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"/>
                                    <TextBox Watermark="Cozy expedition"
                                             FontSize="15"
                                             Text="{Binding NewInstanceName}"
                                             x:Name="NameBox"/>
                                </StackPanel>

                                <!-- Palette picker -->
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Cover art"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg1Brush}"/>
                                    <WrapPanel Orientation="Horizontal" x:Name="PalettePanel">
                                        <Border Width="90" Height="70" CornerRadius="14" Margin="0,0,10,10"
                                                ClipToBounds="True" Cursor="Hand" Tag="grass"
                                                Tapped="Palette_Tapped">
                                            <controls:BlockArtControl Palette="grass"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"/>
                                        </Border>
                                        <Border Width="90" Height="70" CornerRadius="14" Margin="0,0,10,10"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                ClipToBounds="True" Cursor="Hand" Tag="cobble"
                                                Tapped="Palette_Tapped">
                                            <controls:BlockArtControl Palette="cobble"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"/>
                                        </Border>
                                        <Border Width="90" Height="70" CornerRadius="14" Margin="0,0,10,10"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                ClipToBounds="True" Cursor="Hand" Tag="diamond"
                                                Tapped="Palette_Tapped">
                                            <controls:BlockArtControl Palette="diamond"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"/>
                                        </Border>
                                        <Border Width="90" Height="70" CornerRadius="14" Margin="0,0,10,10"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                ClipToBounds="True" Cursor="Hand" Tag="lapis"
                                                Tapped="Palette_Tapped">
                                            <controls:BlockArtControl Palette="lapis"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"/>
                                        </Border>
                                        <Border Width="90" Height="70" CornerRadius="14" Margin="0,0,10,10"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                ClipToBounds="True" Cursor="Hand" Tag="nether"
                                                Tapped="Palette_Tapped">
                                            <controls:BlockArtControl Palette="nether"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"/>
                                        </Border>
                                        <Border Width="90" Height="70" CornerRadius="14" Margin="0,0,10,10"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                ClipToBounds="True" Cursor="Hand" Tag="mauve"
                                                Tapped="Palette_Tapped">
                                            <controls:BlockArtControl Palette="mauve"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"/>
                                        </Border>
                                        <Border Width="90" Height="70" CornerRadius="14" Margin="0,0,10,10"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                ClipToBounds="True" Cursor="Hand" Tag="cherry"
                                                Tapped="Palette_Tapped">
                                            <controls:BlockArtControl Palette="cherry"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"/>
                                        </Border>
                                        <Border Width="90" Height="70" CornerRadius="14" Margin="0,0,10,10"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                ClipToBounds="True" Cursor="Hand" Tag="oakwood"
                                                Tapped="Palette_Tapped">
                                            <controls:BlockArtControl Palette="oakwood"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Tip -->
                                <Border Background="{DynamicResource SecondarySoftBrush}"
                                        CornerRadius="16"
                                        Padding="14">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="🫖" FontSize="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tip. Naming an instance is like naming a houseplant — you'll talk to it."
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Fg1Brush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- Step 2: Version + Mod Loader -->
                            <StackPanel Spacing="0" IsVisible="{Binding IsCreateStep2}">

                                <!-- Version row -->
                                <Border BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="4,14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Minecraft version"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Fg1Brush}"/>
                                            <TextBlock Text="{Binding CurrentCreateVm.SelectedVersionId, FallbackValue='No version chosen yet'}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Fg3Brush}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="secondary"
                                                Padding="14,8"
                                                Command="{Binding CurrentCreateVm.SelectVersionCommand}">
                                            <TextBlock Text="Select…"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Mod loader row -->
                                <Border BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="4,14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mod loader"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Fg1Brush}"/>
                                            <TextBlock Text="Vanilla, Fabric, Quilt, Forge or NeoForge."
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Fg3Brush}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  SelectedIndex="{Binding CurrentCreateVm.SelectedModLoaderIndex, FallbackValue=0}"
                                                  MinWidth="160"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem Content="None"/>
                                            <ComboBoxItem Content="Fabric"/>
                                            <ComboBoxItem Content="Quilt"/>
                                            <ComboBoxItem Content="Forge"/>
                                            <ComboBoxItem Content="NeoForge"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Mod loader version (visible when loader is selected) -->
                                <Border Padding="4,14"
                                        IsVisible="{Binding CurrentCreateVm.ShowModLoaderVersion, FallbackValue=False}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   Text="Loader version"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Fg1Brush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                Padding="12,7"
                                                Command="{Binding CurrentCreateVm.LoadModLoaderVersionsCommand}"
                                                IsEnabled="{Binding CurrentCreateVm.IsLoadingLoaderVersions, Converter={x:Static utils:NotBoolConverter.Instance}, FallbackValue=True}">
                                            <TextBlock Text="Load versions"/>
                                        </Button>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding CurrentCreateVm.ModLoaderVersions, FallbackValue={}}"
                                                  SelectedItem="{Binding CurrentCreateVm.ModLoaderVersion}"
                                                  MinWidth="200"
                                                  VerticalAlignment="Center"
                                                  IsEnabled="{Binding CurrentCreateVm.IsLoadingLoaderVersions, Converter={x:Static utils:NotBoolConverter.Instance}, FallbackValue=True}"/>
                                    </Grid>
                                </Border>

                                <!-- Loading text -->
                                <TextBlock Text="Loading versions…"
                                           FontSize="12"
                                           Foreground="{DynamicResource Fg3Brush}"
                                           IsVisible="{Binding CurrentCreateVm.IsLoadingLoaderVersions, FallbackValue=False}"
                                           Margin="4,4,4,8"/>

                                <!-- Error message -->
                                <Border Background="{DynamicResource DangerSoftBrush}"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        Margin="0,8,0,0"
                                        IsVisible="{Binding CurrentCreateVm.ErrorMessage, Converter={x:Static utils:StringNotEmptyConverter.Instance}, FallbackValue=False}">
                                    <TextBlock Text="{Binding CurrentCreateVm.ErrorMessage, FallbackValue=''}"
                                               FontSize="12"
                                               Foreground="{DynamicResource DangerBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                            </StackPanel>

                            <!-- Step 3: Summary + Create -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsCreateStep3}">

                                <!-- Summary card -->
                                <Border Background="{DynamicResource Surface0Brush}"
                                        CornerRadius="16"
                                        Padding="18">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <Border Width="56" Height="44" CornerRadius="10" ClipToBounds="True">
                                            <controls:BlockArtControl Palette="{Binding NewInstancePalette}"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NewInstanceName, FallbackValue='Unnamed'}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Fg1Brush}"/>
                                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{DynamicResource PrimaryTintBrush}"
                                                        CornerRadius="999"
                                                        Padding="9,3"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding CurrentCreateVm.SelectedVersionId, FallbackValue='—'}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource SecondarySoftBrush}"
                                                        CornerRadius="999"
                                                        Padding="9,3"
                                                        IsVisible="{Binding CurrentCreateVm.ShowModLoaderVersion, FallbackValue=False}">
                                                    <TextBlock Text="{Binding CurrentCreateVm.SelectedModLoader, FallbackValue=''}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryBrush}"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Progress area (visible during creation) -->
                                <StackPanel Spacing="8"
                                            IsVisible="{Binding CurrentCreateVm.IsCreating, FallbackValue=False}">
                                    <ProgressBar Value="{Binding CurrentCreateVm.ProgressValue, FallbackValue=0}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="6"
                                                 CornerRadius="3"/>
                                    <TextBlock Text="{Binding CurrentCreateVm.ProgressText, FallbackValue=''}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Fg3Brush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Error message -->
                                <Border Background="{DynamicResource DangerSoftBrush}"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        IsVisible="{Binding CurrentCreateVm.ErrorMessage, Converter={x:Static utils:StringNotEmptyConverter.Instance}, FallbackValue=False}">
                                    <TextBlock Text="{Binding CurrentCreateVm.ErrorMessage, FallbackValue=''}"
                                               FontSize="12"
                                               Foreground="{DynamicResource DangerBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="We'll download Minecraft and any needed libraries. Grab a tea."
                                           FontSize="13"
                                           Foreground="{DynamicResource Fg3Brush}"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Panel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource MantleBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <!-- Cancel (step 1) / Back (steps 2-3) -->
                            <Button Grid.Column="0"
                                    Classes="ghost"
                                    Padding="14,8"
                                    Command="{Binding CloseCreateInstanceCommand}"
                                    IsVisible="{Binding IsCreateStep1}">
                                <TextBlock Text="Cancel"/>
                            </Button>
                            <Button Grid.Column="0"
                                    Classes="ghost"
                                    Padding="14,8"
                                    Command="{Binding RewindCreateStepCommand}"
                                    IsVisible="{Binding IsCreateStep1, Converter={x:Static utils:NotBoolConverter.Instance}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="←" VerticalAlignment="Center"/>
                                    <TextBlock Text="Back" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Right side buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">

                                <!-- Steps 1 and 2: Next → -->
                                <Button Classes="primary"
                                        Padding="14,8"
                                        Command="{Binding AdvanceCreateStepCommand}"
                                        IsVisible="{Binding IsCreateStep3, Converter={x:Static utils:NotBoolConverter.Instance}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Next" VerticalAlignment="Center"/>
                                        <TextBlock Text="→" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Step 3: Create button -->
                                <Button Classes="primary"
                                        Padding="14,8"
                                        Command="{Binding CurrentCreateVm.CreateCommand}"
                                        IsVisible="{Binding IsCreateStep3}"
                                        IsEnabled="{Binding CurrentCreateVm.IsCreating, Converter={x:Static utils:NotBoolConverter.Instance}, FallbackValue=True}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="✓" VerticalAlignment="Center"/>
                                        <TextBlock Text="Create instance" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

            </Border>

        </Grid>
    </Border>

</UserControl>
