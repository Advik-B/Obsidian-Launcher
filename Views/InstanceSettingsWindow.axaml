<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ObsidianLauncher.ViewModels"
        xmlns:utils="using:ObsidianLauncher.Utils"
        x:Class="ObsidianLauncher.Views.InstanceSettingsWindow"
        x:CompileBindings="False"
        Title="Instance Settings"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Design.DataContext>
        <vm:InstanceSettingsViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <utils:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Instance Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Tabbed Content -->
        <TabControl Grid.Row="1">
            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="15">
                        <TextBlock Text="Instance Information" FontWeight="SemiBold" FontSize="14"/>

                        <!-- Icon + Name side by side -->
                        <Grid ColumnDefinitions="Auto,12,*">
                            <StackPanel Grid.Column="0" Spacing="6" Width="80">
                                <Border Width="72" Height="72" CornerRadius="8" ClipToBounds="True"
                                        Background="#40808080">
                                    <Panel>
                                        <Image Source="{Binding CustomIconPath, Converter={StaticResource FilePathToBitmapConverter}}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding CustomIconPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="?"
                                                   FontSize="28" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Opacity="0.5"
                                                   IsVisible="{Binding CustomIconPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                    </Panel>
                                </Border>
                                <Button Content="Change Icon" Command="{Binding PickIconCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        FontSize="11" Padding="4,3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Instance Name:"/>
                                    <TextBox Text="{Binding Name}" PlaceholderText="Enter instance name"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Author:"/>
                                    <TextBox Text="{Binding Author}" PlaceholderText="Enter author name (optional)"/>
                                </StackPanel>
                                <CheckBox Content="Mark as Favorite" IsChecked="{Binding IsFavorite}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Version Tab -->
            <TabItem Header="Version">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="10">
                        <TextBlock Text="Version Information" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding VersionDisplayText}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Notes Tab -->
            <TabItem Header="Notes">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="10">
                        <TextBlock Text="Instance Notes" FontWeight="SemiBold" FontSize="14"/>
                        <TextBox Text="{Binding Notes}"
                                 AcceptsReturn="True"
                                 MinHeight="200"
                                 TextWrapping="Wrap"
                                 PlaceholderText="Enter notes about this instance..."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Java Settings Tab -->
            <TabItem Header="Java">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="15">
                        <CheckBox Content="Use custom Java settings (override global settings)"
                                  IsChecked="{Binding UseCustomJavaSettings}"
                                  FontWeight="SemiBold"/>

                        <StackPanel Spacing="8" IsEnabled="{Binding UseCustomJavaSettings}">
                            <TextBlock Text="Java Executable Path:"/>
                            <Grid ColumnDefinitions="*,10,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding JavaPath}"
                                         PlaceholderText="Auto-detect if empty"/>
                                <Button Grid.Column="2"
                                        Content="Browse..."
                                        Command="{Binding BrowseJavaPathCommand}"
                                        Width="100"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8" IsEnabled="{Binding UseCustomJavaSettings}">
                            <TextBlock Text="Minimum Memory (MB):"/>
                            <Grid ColumnDefinitions="*,10,Auto">
                                <Slider Grid.Column="0"
                                        Minimum="256"
                                        Maximum="16384"
                                        TickFrequency="256"
                                        Value="{Binding MinMemoryMB}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding MinMemoryMB, StringFormat='{}{0} MB'}"
                                           VerticalAlignment="Center"
                                           Width="80"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8" IsEnabled="{Binding UseCustomJavaSettings}">
                            <TextBlock Text="Maximum Memory (MB):"/>
                            <Grid ColumnDefinitions="*,10,Auto">
                                <Slider Grid.Column="0"
                                        Minimum="512"
                                        Maximum="32768"
                                        TickFrequency="512"
                                        Value="{Binding MaxMemoryMB}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding MaxMemoryMB, StringFormat='{}{0} MB'}"
                                           VerticalAlignment="Center"
                                           Width="80"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8" IsEnabled="{Binding UseCustomJavaSettings}">
                            <TextBlock Text="Additional JVM Arguments:"/>
                            <TextBox Text="{Binding JavaArgs}"
                                     PlaceholderText="e.g., -XX:+UnlockExperimentalVMOptions"
                                     AcceptsReturn="True"
                                     Height="60"
                                     TextWrapping="Wrap"/>
                            <TextBlock Text="Advanced users only. Separate arguments with spaces."
                                       Foreground="Gray"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Game Settings Tab -->
            <TabItem Header="Game">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="15">
                        <CheckBox Content="Use custom game settings (override global settings)"
                                  IsChecked="{Binding UseCustomGameSettings}"
                                  FontWeight="SemiBold"/>

                        <StackPanel Spacing="8" IsEnabled="{Binding UseCustomGameSettings}">
                            <TextBlock Text="Window Size:"/>
                            <Grid ColumnDefinitions="Auto,10,*,20,Auto,10,*">
                                <TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="2"
                                               Value="{Binding WindowWidth}"
                                               Minimum="640"
                                               Maximum="7680"
                                               Increment="10"/>
                                <TextBlock Grid.Column="4" Text="Height:" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="6"
                                               Value="{Binding WindowHeight}"
                                               Minimum="480"
                                               Maximum="4320"
                                               Increment="10"/>
                            </Grid>
                        </StackPanel>

                        <CheckBox Content="Fullscreen Mode"
                                  IsChecked="{Binding Fullscreen}"
                                  IsEnabled="{Binding UseCustomGameSettings}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Launch Tab -->
            <TabItem Header="Launch">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="15">
                        <TextBlock Text="Launch Pipeline" FontWeight="SemiBold" FontSize="14"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Pre-launch command:"/>
                            <TextBox Text="{Binding PreLaunchCommand}" PlaceholderText="Command to run before game starts"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Post-exit command:"/>
                            <TextBox Text="{Binding PostLaunchCommand}" PlaceholderText="Command to run after game exits"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Wrapper command:"/>
                            <TextBox Text="{Binding WrapperCommand}" PlaceholderText="e.g. mangohud, gamescope"/>
                        </StackPanel>

                        <TextBlock Text="Quick Play" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Quick play server (host:port):"/>
                            <TextBox Text="{Binding QuickPlayServer}" PlaceholderText="e.g. play.example.com:25565"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Quick play world (singleplayer):"/>
                            <TextBox Text="{Binding QuickPlayWorld}" PlaceholderText="World folder name"/>
                        </StackPanel>

                        <TextBlock Text="Environment Variables" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>

                        <DataGrid ItemsSource="{Binding EnvironmentVariables}"
                                  SelectedItem="{Binding SelectedEnvVar}"
                                  AutoGenerateColumns="False"
                                  Height="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add" Command="{Binding AddEnvVarCommand}" Padding="12,4"/>
                            <Button Content="Remove"
                                    Command="{Binding RemoveEnvVarCommand}"
                                    IsEnabled="{Binding SelectedEnvVar, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Mods Tab -->
            <TabItem Header="Mods">
                <DockPanel Margin="10">
                    <!-- Action bar at bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Toggle Enable/Disable" Command="{Binding ToggleModCommand}" Padding="12,4"
                                IsEnabled="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="Delete" Command="{Binding DeleteModCommand}" Padding="12,4"
                                IsEnabled="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="Open Folder" Command="{Binding OpenModsFolderCommand}" Padding="12,4"/>
                        <Button Content="Refresh" Command="{Binding LoadModsCommand}" Padding="12,4"/>
                    </StackPanel>
                    <!-- Status -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ModsStatusText}" FontSize="11" Opacity="0.7" Margin="0,4,0,0"/>
                    <!-- List -->
                    <ListBox ItemsSource="{Binding Mods}"
                             SelectedItem="{Binding SelectedMod}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4">
                                    <CheckBox IsChecked="{Binding IsEnabled}" IsHitTestVisible="False"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SizeBytes, StringFormat='{}{0:N0} bytes'}" FontSize="10" Opacity="0.6"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Resource Packs Tab -->
            <TabItem Header="Resource Packs">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Open Folder" Command="{Binding OpenResourcePacksFolderCommand}" Padding="12,4"/>
                        <Button Content="Refresh" Command="{Binding LoadResourcePacksCommand}" Padding="12,4"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ResourcePacks}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="4" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Shader Packs Tab -->
            <TabItem Header="Shader Packs">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Open Folder" Command="{Binding OpenShaderPacksFolderCommand}" Padding="12,4"/>
                        <Button Content="Refresh" Command="{Binding LoadShaderPacksCommand}" Padding="12,4"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ShaderPacks}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="4" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Worlds Tab -->
            <TabItem Header="Worlds">
                <StackPanel Margin="10" Spacing="10">
                    <TextBlock Text="World Manager" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Manage your Minecraft worlds for this instance." TextWrapping="Wrap" Opacity="0.7"/>
                    <Button Content="Open World Manager..." Command="{Binding OpenWorldManagerCommand}" Padding="12,6" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <!-- Servers Tab -->
            <TabItem Header="Servers">
                <StackPanel Margin="10" Spacing="10">
                    <TextBlock Text="Server List" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="The server list is stored in servers.dat inside the instance folder. Edit it in-game or use the button below to open the instance folder."
                               TextWrapping="Wrap" Opacity="0.7"/>
                    <Button Content="Open Instance Folder" Command="{Binding OpenInstanceFolderCommand}"
                            Padding="12,6" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <!-- Other Logs Tab -->
            <TabItem Header="Other Logs">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Open Selected Log" Command="{Binding OpenLogFileCommand}" Padding="12,4"
                                IsEnabled="{Binding SelectedLogFile, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="Refresh" Command="{Binding RefreshLogFilesCommand}" Padding="12,4"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding LogFiles}"
                             SelectedItem="{Binding SelectedLogFile}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="4" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Screenshots Tab -->
            <TabItem Header="Screenshots">
                <StackPanel Margin="10" Spacing="10">
                    <TextBlock Text="Screenshots" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="View and manage screenshots taken in this instance." TextWrapping="Wrap" Opacity="0.7"/>
                    <Button Content="Open Screenshot Viewer..." Command="{Binding OpenScreenshotViewerCommand}" Padding="12,6" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Width="100" Click="SaveButton_Click"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
