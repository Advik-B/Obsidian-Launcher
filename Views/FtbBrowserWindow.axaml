<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="500"
        x:Class="ObsidianLauncher.Views.FtbBrowserWindow"
        x:CompileBindings="False"
        Title="Browse FTB Modpacks"
        Width="720" Height="500"
        MinWidth="580" MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">

        <!-- Search bar (top) -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Grid.Column="0"
                     PlaceholderText="Search FTB packs…"
                     Margin="0,0,8,0"/>
            <Button x:Name="SearchBtn" Grid.Column="1" Content="Search" Padding="16,6"/>
        </Grid>

        <!-- Status + action bar (bottom) -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.7"/>
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Width="100" Height="14"
                             IsVisible="False"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ImportBtn" Content="Import" Padding="16,6" IsEnabled="False"/>
                <Button Content="Cancel" IsCancel="True" Padding="14,6" Click="CancelBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Master-detail split -->
        <Grid ColumnDefinitions="*,1,220">

            <!-- Pack list (left) -->
            <ListBox x:Name="PackListBox" Grid.Column="0"
                     SelectionChanged="PackListBox_SelectionChanged"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,5" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Synopsis}" FontSize="11" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Separator -->
            <Border Grid.Column="1" Background="{DynamicResource BorderSoftBrush}" Width="1" Margin="6,0"/>

            <!-- Version + info panel (right) -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="VERSION" FontSize="10" FontWeight="Bold"
                           Opacity="0.5" LetterSpacing="0.12" Margin="4,0,0,6"/>
                <TextBlock x:Name="PackDescText" DockPanel.Dock="Top"
                           FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                           Margin="4,0,4,10" MaxHeight="80"
                           IsVisible="False"/>
                <TextBlock DockPanel.Dock="Top" x:Name="NoVersionsText"
                           Text="Select a pack to see versions."
                           Opacity="0.5" FontSize="11" Margin="4,0"
                           IsVisible="True"/>
                <ComboBox x:Name="VersionCombo" DockPanel.Dock="Top"
                          IsVisible="False" HorizontalAlignment="Stretch"
                          Margin="0,0,0,0"/>
            </DockPanel>

        </Grid>

    </DockPanel>

</Window>
