<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ObsidianLauncher.ViewModels"
        x:Class="ObsidianLauncher.Views.VersionSelectorWindow"
        x:CompileBindings="False"
        Title="Select Minecraft Version"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Design.DataContext>
        <vm:VersionSelectorViewModel/>
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Select Minecraft Version" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Filter and Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText}"
                     Watermark="Search versions..."
                     VerticalContentAlignment="Center"/>

            <!-- Refresh Button -->
            <Button Grid.Column="2"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Width="100"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Version List -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="5">
                <ListBox ItemsSource="{Binding FilteredVersions}"
                         SelectedItem="{Binding SelectedVersionEntry}"
                         BorderThickness="0"
                         DoubleTapped="VersionList_DoubleTapped">
                    <ListBox.KeyBindings>
                        <KeyBinding Gesture="Return" Command="{Binding SelectCommand}"/>
                    </ListBox.KeyBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Text="{Binding Id}" Width="150" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TypeDisplay}" Width="80" VerticalAlignment="Center" Foreground="Gray"/>
                                <TextBlock Text="{Binding ReleaseTime, StringFormat='yyyy-MM-dd'}" VerticalAlignment="Center" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Filter Options -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10" Width="200">
                <StackPanel Spacing="8">
                    <TextBlock Text="Filters" FontWeight="SemiBold" Margin="0,0,0,5"/>

                    <CheckBox Content="Show Snapshots"
                              IsChecked="{Binding ShowSnapshots}"/>

                    <CheckBox Content="Show Old Beta"
                              IsChecked="{Binding ShowOldBeta}"/>

                    <CheckBox Content="Show Old Alpha"
                              IsChecked="{Binding ShowOldAlpha}"/>

                    <Separator Margin="0,10"/>

                    <CheckBox Content="Releases Only"
                              IsChecked="{Binding ShowReleasesOnly}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Select" Command="{Binding SelectCommand}" Width="100" Click="SelectButton_Click"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
